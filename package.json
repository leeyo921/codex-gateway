{
  "name": "codex-gateway",
  "version": "0.1.0",
  "description": "codex-gateway - The Unified Codex Desktop Unlocker, Custom Model Gateway & Computer Use Router",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc --watch",
    "postinstall": "tsc",
    "bundle": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=build/bundle.cjs --external:fsevents",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "esbuild": "^0.28.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.9.3"
  }
}
